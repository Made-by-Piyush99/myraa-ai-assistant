<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Holographic Ring -->
    <path
        android:strokeWidth="1.8"
        android:pathData="M 54,26 A 28,28 0 1,1 53.9,26 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="26"
                android:startY="26"
                android:endX="82"
                android:endY="82"
                android:startColor="#06B6D4"
                android:endColor="#A855F7" />
        </aapt:attr>
    </path>

    <!-- Subtle Orbital Pulse Nodes -->
    <path
        android:fillColor="#00F0FF"
        android:pathData="M 54,23 A 3,3 0 1,1 53.9,23 Z" />
    <path
        android:fillColor="#C084FC"
        android:pathData="M 54,82 A 3,3 0 1,1 53.9,82 Z" />
    <path
        android:fillColor="#38BDF8"
        android:pathData="M 24.5,54 A 2.5,2.5 0 1,1 24.4,54 Z" />
    <path
        android:fillColor="#E879F9"
        android:pathData="M 83.5,54 A 2.5,2.5 0 1,1 83.4,54 Z" />

    <!-- Core Geometric "M" Logo (MYRAA) -->
    <path
        android:strokeWidth="4.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 38,66 L 38,42 L 54,55 L 70,42 L 70,66">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="38"
                android:startY="42"
                android:endX="70"
                android:endY="66"
                android:startColor="#22D3EE"
                android:endColor="#E879F9" />
        </aapt:attr>
    </path>

    <!-- Center AI Core Flare -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 54,53 A 2.2,2.2 0 1,1 53.9,53 Z" />

</vector>
